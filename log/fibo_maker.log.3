consumer 2026-05-13 21:14:21,341 INFO TextDTO(titles=['Взаимодействие родителей и детей', 'Роль родителей в воспитании детей'], slides_text_list=[['В 1985 году исследование ЮНИСЕФ подчеркнуло роль доверия в развитии детей.', 'В 2000 году психологи Леви и Смирнова доказали, что эмоциональная поддержка влияет на успех в школе.', 'В 2010 году было отмечено, что совместное время укрепляет семейные связи.'], ['В 1990 году учёные отметили, что родители передают ценности, важные для будущего поколения.', 'В 2005 году было установлено, что участие родителей повышает академические достижения детей.', 'В 2015 году исследование показало, что контроль за экранным временем способствует развитию социальных навыков.']], picture_discription_list=['Семья из четырех человек — родители и двое детей, сидят вместе за столом, беседуют и улыбаются.', 'Родитель читает книгу своему ребенку, сидя на диване в уютной гостиной.'], fulltext='Слайд 1:Взаимодействие родителей и детей\nВажность доверияВ 1985 году исследование ЮНИСЕФ подчеркнуло роль доверия в развитии детей.\nЭмоциональная поддержкаВ 2000 году психологи Леви и Смирнова доказали, что эмоциональная поддержка влияет на успех в школе.\nСовместное времяпрепровождениеВ 2010 году было отмечено, что совместное время укрепляет семейные связи.\nСлайд 2:Роль родителей в воспитании детей\nФормирование ценностейВ 1990 году учёные отметили, что родители передают ценности, важные для будущего поколения.\nОбразовательная поддержкаВ 2005 году было установлено, что участие родителей повышает академические достижения детей.\nОграничение времени у гаджетовВ 2015 году исследование показало, что контроль за экранным временем способствует развитию социальных навыков.\n', theme='родители и дети', subtitles_1=['Важность доверия', 'Формирование ценностей'], subtitles_2=['Эмоциональная поддержка', 'Образовательная поддержка'], subtitles_3=['Совместное времяпрепровождение', 'Ограничение времени у гаджетов'])
